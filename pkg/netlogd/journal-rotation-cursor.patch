Description: Keep the last cursor when the current entry was rotated away
 When journald rotates the file holding the current entry and no entry has
 been read since, sd_journal_get_cursor() returns -EADDRNOTAVAIL. The
 cursor read after each batch then logged "Failed to get cursor: Cannot
 assign requested address" for every journal event until the next entry
 arrived, and dropped the cursor it would save. The last
 cursor is still the right one in that case: keep it, at debug level.
Author: Andrei-Alexandru Bleortu <me@andrei-z.com>
Forwarded: no
Last-Update: 2026-10-23
---
--- a/src/netlog/netlog-manager.c
+++ b/src/netlog/netlog-manager.c
@@ -341,6 +341,12 @@
         }
 
         r = sd_journal_get_cursor(m->journal, &cursor);
+        if (r == -EADDRNOTAVAIL) {
+                /* The journal file of the current entry was rotated away and
+                 * no entry has been read since: the last cursor still holds. */
+                log_debug_errno(r, "No current journal entry, keeping the last cursor: %m");
+                return 0;
+        }
         if (r < 0) {
                 log_error_errno(r, "Failed to get cursor: %m");
                 cursor = mfree(cursor);
