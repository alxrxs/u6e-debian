+
+
+#ifdef CONFIG_RADIUS_TLS
+/*
+ * RADIUS over TLS (RFC 6614) is a byte stream: a decrypted chunk can hold
+ * several RADIUS messages or part of one. Collect it and process every
+ * complete message, framed by its Length field.
+ */
+static int radius_client_tls_rx(struct radius_client_data *radius,
+				RadiusType msg_type, const struct wpabuf *data)
+{
+	struct wpabuf **rx = msg_type == RADIUS_ACCT ? &radius->acct_tls_rx :
+		&radius->auth_tls_rx;
+	u8 msg[RADIUS_MAX_MSG_LEN];
+	size_t len;
+
+	if (wpabuf_resize(rx, wpabuf_len(data)))
+		return -1;
+	wpabuf_put_buf(*rx, data);
+
+	while (*rx && wpabuf_len(*rx) >= sizeof(struct radius_hdr)) {
+		len = WPA_GET_BE16(wpabuf_head_u8(*rx) + 2);
+		if (len < sizeof(struct radius_hdr) ||
+		    len > RADIUS_MAX_MSG_LEN) {
+			wpa_printf(MSG_INFO,
+				   "RADIUS: Invalid message length %zu from TLS",
+				   len);
+			return -1;
+		}
+		if (wpabuf_len(*rx) < len) {
+			wpa_printf(MSG_DEBUG,
+				   "RADIUS: Full message not yet received - continue waiting for additional TLS data");
+			break;
+		}
+		os_memcpy(msg, wpabuf_head(*rx), len);
+		os_memmove(wpabuf_mhead(*rx), wpabuf_head_u8(*rx) + len,
+			   wpabuf_len(*rx) - len);
+		(*rx)->used -= len;
+		/* The handler can close the connection and free *rx. */
+		radius_client_handle_msg(radius, msg_type, msg, len);
+	}
+
+	return 0;
+}
+#endif /* CONFIG_RADIUS_TLS */
+
+
+static void radius_client_receive(int sock, void *eloop_ctx, void *sock_ctx)
+{
+	struct radius_client_data *radius = eloop_ctx;
+	RadiusType msg_type = (uintptr_t) sock_ctx;
+	int len;
+	unsigned char buf[RADIUS_MAX_MSG_LEN];
+	struct msghdr msghdr = {0};
+	struct iovec iov;
+#ifdef CONFIG_RADIUS_TLS
+	struct tls_connection *conn = NULL;
+	bool tls, tls_ready;
+
+	if (msg_type == RADIUS_ACCT) {
+		if (radius->acct_tls)
+			conn = radius->acct_tls_conn;
+		tls = radius->acct_tls;
+		tls_ready = radius->acct_tls_ready;
+	} else {
+		if (radius->auth_tls)
+			conn = radius->auth_tls_conn;
+		tls = radius->auth_tls;
+		tls_ready = radius->auth_tls_ready;
+	}
+#endif /* CONFIG_RADIUS_TLS */
+
+	iov.iov_base = buf;
+	iov.iov_len = RADIUS_MAX_MSG_LEN;
+	msghdr.msg_iov = &iov;
+	msghdr.msg_iovlen = 1;
+	msghdr.msg_flags = 0;
+	len = recvmsg(sock, &msghdr, MSG_DONTWAIT);
+	if (len < 0) {
+		wpa_printf(MSG_INFO, "recvmsg[RADIUS]: %s", strerror(errno));
+		return;
+	}
+#ifdef CONFIG_RADIUS_TLS
+	if (tls && len == 0) {
+		wpa_printf(MSG_DEBUG, "RADIUS: No TCP data available");
+		goto close_tcp;
+	}
+
+	if (tls && !tls_ready) {
+		radius_client_process_tls_handshake(radius, sock, msg_type,
+						    buf, len);
+		return;
+	}
+
+	if (conn) {
+		struct wpabuf *out, *in;
+		int res;
+
+		in = wpabuf_alloc_copy(buf, len);
+		if (!in)
+			return;
+		wpa_printf(MSG_DEBUG,
+			   "RADIUS: Process %d bytes of encrypted TLS data",
+			   len);
+		out = tls_connection_decrypt(radius->tls_ctx, conn, in);
+		wpabuf_free(in);
+		if (!out) {
+			wpa_printf(MSG_INFO,
+				   "RADIUS: Failed to decrypt TLS data");
+			goto close_tcp;
+		}
+		res = radius_client_tls_rx(radius, msg_type, out);
+		wpabuf_free(out);
+		if (res < 0)
+			goto close_tcp;
+		return;
+	}
+#endif /* CONFIG_RADIUS_TLS */
+
+	if (msghdr.msg_flags & MSG_TRUNC) {
+		wpa_printf(MSG_INFO, "RADIUS: Possibly too long UDP frame for our buffer - dropping it");
+		return;
+	}
+
+	radius_client_handle_msg(radius, msg_type, buf, len);
 	return;
 
 #ifdef CONFIG_RADIUS_TLS
