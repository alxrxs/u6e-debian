
# Added for the U6 Enterprise: every hostapd feature the AP can use.
CONFIG_RADIUS_TLS=y
CONFIG_PROXYARP=y
CONFIG_PASN=y
CONFIG_DPP3=y
CONFIG_EAP_TEAP=y
CONFIG_PMKSA_PRIVACY=y
CONFIG_TAXONOMY=y
CONFIG_ENC_ASSOC=y
CONFIG_IEEE80211BE=y
CONFIG_NAN_USD=y
CONFIG_SQLITE=y
CONFIG_ELOOP_EPOLL=y
CONFIG_DEBUG_SYSLOG=y
CONFIG_ROBUST_AV=y
