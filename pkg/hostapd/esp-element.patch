 src/ap/drv_callbacks.c      | 11 +++++++++
 src/ap/hostapd.h            |  3 +++
 src/ap/ieee802_11.h         |  1 +
 src/ap/ieee802_11_shared.c  | 40 ++++++++++++++++++++++++++++++++
 tests/hwsim/test_ap_open.py | 46 +++++++++++++++++++++++++++++++++++++
 9 files changed, 119 insertions(+)

