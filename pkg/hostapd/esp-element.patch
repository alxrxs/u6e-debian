diff --git a/hostapd/hostapd.conf b/hostapd/hostapd.conf
index 6918591f9..b8c269263 100644
--- a/hostapd/hostapd.conf
+++ b/hostapd/hostapd.conf
@@ -582,6 +582,17 @@ wmm_ac_vo_acm=0
 # Beacon and Probe Response frames.
 #bss_load_update_period=50
 
+# Estimated Service Parameters Inbound element (IEEE Std 802.11-2024, 9.4.2.172)
+# This adds the element to Beacon and Probe Response frames, so that STAs can
+# estimate their throughput before associating (also used by Wi-Fi Optimized
+# Connectivity). It carries the AC_BE parameters, with an estimate of the air
+# time a new STA would get from the channel time not used by other BSSs, shared
+# equally between it and the associated STAs. This requires
+# bss_load_update_period to be set.
+# 0 = disabled (default)
+# 1 = enabled
+#esp=0
+
 # Channel utilization averaging period (in BUs)
 # This field is used to enable and configure channel utilization average
 # calculation with bss_load_update_period. This should be in multiples of
