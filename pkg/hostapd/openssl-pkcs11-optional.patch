From cbf538a02a9f0f20b451db94431596f4058b5c94 Mon Sep 17 00:00:00 2001
From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Date: Fri, 23 Oct 2026 19:23:17 +0300
Subject: [PATCH] OpenSSL: Do not leave the errors of a missing PKCS#11
 provider queued

With OPENSSL_NO_ENGINE, tls_init() tries to load the PKCS#11 provider,
which is optional and usually not installed. The failed load left its
errors ("DSO support routines::could not load the shared library") in
the OpenSSL error queue, and the first TLS connection then reported them
as "Clearing pending SSL error" in addition to the "PKCS11 provider not
present" warning at every start. Clear them, and report the absence of
the optional provider at debug level.

Assisted-by: LLM
---
 src/crypto/tls_openssl.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/crypto/tls_openssl.c b/src/crypto/tls_openssl.c
index 275ddd1d2..1b72f49ef 100644
--- a/src/crypto/tls_openssl.c
+++ b/src/crypto/tls_openssl.c
@@ -377,8 +377,12 @@ static void openssl_load_pkcs11_provider(void)
 		return;
 
 	openssl_pkcs11_provider = OSSL_PROVIDER_try_load(NULL, "pkcs11", 1);
-	if (!openssl_pkcs11_provider)
-		wpa_printf(MSG_WARNING, "PKCS11 provider not present");
+	if (!openssl_pkcs11_provider) {
+		/* The provider is optional; do not leave the errors of the
+		 * failed load for the first TLS connection to report. */
+		ERR_clear_error();
+		wpa_printf(MSG_DEBUG, "PKCS11 provider not present");
+	}
 #endif /* OpenSSL version >= 3.0 */
 }
 
