From 7d5cc2e2db21325bb6517ddd2bf72aaad44e8d7c Mon Sep 17 00:00:00 2001
From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Date: Sat, 3 Oct 2026 20:43:31 +0300
Subject: [PATCH] hostapd: Allow the primary/secondary channel switch to be
 disabled

Before enabling a 40 MHz or wider channel, hostapd scans for neighboring
BSSs and swaps its primary and secondary 20 MHz channels when another BSS
has its primary channel on this BSS's secondary channel. The swap can
already be suppressed with no_pri_sec_switch, but only P2P GO and mesh
set it. An operator running a planned channel layout has no way to keep
the configured primary channel.

Expose no_pri_sec_switch as a configuration parameter.

Signed-off-by: Andrei-Alexandru Bleortu <me@andrei-z.com>
---
 hostapd/config_file.c | 2 ++
 hostapd/hostapd.conf  | 7 +++++++
 2 files changed, 9 insertions(+)

diff --git a/hostapd/config_file.c b/hostapd/config_file.c
index 59827966e..d5ab87403 100644
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -3700,6 +3700,8 @@ static int hostapd_config_fill(struct hostapd_config *conf,
 		conf->ht_vht_twt_responder = atoi(pos);
 	} else if (os_strcmp(buf, "obss_interval") == 0) {
 		conf->obss_interval = atoi(pos);
+	} else if (os_strcmp(buf, "no_pri_sec_switch") == 0) {
+		conf->no_pri_sec_switch = atoi(pos);
 #ifdef CONFIG_IEEE80211AC
 	} else if (os_strcmp(buf, "ieee80211ac") == 0) {
 		conf->ieee80211ac = atoi(pos);
diff --git a/hostapd/hostapd.conf b/hostapd/hostapd.conf
index 0e9001221..16fb39309 100644
--- a/hostapd/hostapd.conf
+++ b/hostapd/hostapd.conf
@@ -673,6 +673,13 @@ wmm_ac_vo_acm=0
 # no co-existence issues with neighboring devices are found.
 #obss_interval=0
 
+# Keep the configured primary and secondary 40 MHz channels
+# Before enabling a 40 MHz (or wider) channel, hostapd scans for neighboring
+# BSSs and, if another BSS has its primary channel on this BSS's secondary
+# channel, swaps the two. Setting this to 1 skips that check and keeps the
+# primary channel as configured.
+#no_pri_sec_switch=0
+
 # ht_vht_twt_responder: Whether TWT responder is enabled in HT and VHT modes
 # 0 = disable; Disable TWT responder support in  HT and VHT modes (default).
 # 1 = enable; Enable TWT responder support in HT and VHT modes if supported by
