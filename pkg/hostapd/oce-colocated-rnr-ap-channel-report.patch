 src/ap/ieee802_11.c          | 152 ++++++++++++++++++++++++++++++++---
 src/ap/ieee802_11.h          |   3 +
 src/common/ieee802_11_defs.h |   2 +
 tests/hwsim/test_oce.py      |  56 +++++++++++++
