 {
 	if (anqp_add_override(hapd, buf, ANQP_VENUE_URL))
@@ -1114,6 +1147,16 @@ gas_serv_build_gas_resp_payload(struct hostapd_data *hapd,
 			continue;
 		}
 #endif /* CONFIG_FILS */
