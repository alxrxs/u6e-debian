diff --git a/src/ap/roam_prune.c b/src/ap/roam_prune.c
new file mode 100644
index 0000000..442db6f
--- /dev/null
+++ b/src/ap/roam_prune.c
@@ -0,0 +1,197 @@
+/*
+ * Removal of STAs that reassociated to another AP of the ESS
+ *
+ * This software may be distributed under the terms of the BSD license.
+ * See README for more details.
+ *
+ * A STA that reassociates to another AP does not tell the AP it leaves, and
+ * that AP keeps it associated until the inactivity timer or excessive
+ * missing ACKs remove it. Neither happens while the STA still acknowledges
+ * some of the frames sent to it on this AP's channel (it visits the channel
+ * for peer-to-peer links, say), and meanwhile this AP keeps sending it what
+ * is addressed to it: its other STAs' frames, group frames sent as unicast.
+ *
+ * The AP that the STA associated with sends a Layer 2 Update frame with the
+ * STA's address as the source, so that bridges and switches learn where the
+ * STA is (IEEE Std 802.11F-2003; the kernel sends it on every association).
+ * Received from the distribution system - on a wired port of a bridge - it
+ * shows that the STA associated elsewhere. The STA is then removed unless it
+ * transmits to this AP within ROAM_PRUNE_CHECK_SEC, which a STA still here
+ * does and one that left does not, so that a forged frame cannot remove an
+ * active STA. The STA is not sent a Deauthentication frame: it is not here.
+ */
+
+#include "utils/includes.h"
+#include <sys/socket.h>
+#include <net/if.h>
+#include <linux/if_packet.h>
+#include <linux/if_ether.h>
+#include <linux/filter.h>
+
+#include "utils/common.h"
+#include "utils/eloop.h"
+#include "common/ieee802_11_defs.h"
+#include "hostapd.h"
+#include "ap_drv_ops.h"
+#include "sta_info.h"
+#include "roam_prune.h"
+
+#define ROAM_PRUNE_CHECK_SEC 2
+
+/*
+ * The Layer 2 Update frame: DA broadcast, an IEEE 802.3 length of 6, and an
+ * LLC XID response (DSAP 0x00, SSAP 0x01, control 0xaf, XID information
+ * 0x81 0x01 0x00). Anything else is dropped in the kernel.
+ */
+static struct sock_filter l2_update_filter[] = {
+	BPF_STMT(BPF_LD | BPF_W | BPF_ABS, 0),
+	BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 0xffffffff, 0, 9),
+	BPF_STMT(BPF_LD | BPF_H | BPF_ABS, 4),
+	BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 0xffff, 0, 7),
+	BPF_STMT(BPF_LD | BPF_H | BPF_ABS, 12),
+	BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 0x0006, 0, 5),
+	BPF_STMT(BPF_LD | BPF_W | BPF_ABS, 14),
+	BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 0x0001af81, 0, 3),
+	BPF_STMT(BPF_LD | BPF_H | BPF_ABS, 18),
+	BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 0x0100, 0, 1),
+	BPF_STMT(BPF_RET | BPF_K, 20),
+	BPF_STMT(BPF_RET | BPF_K, 0),
+};
+
+
+/* Whether netdev ifname is a bridge port that is not a wireless interface:
+ * a frame received on it comes from the distribution system. */
+static bool from_ds_port(const char *ifname)
+{
+	char path[128];
+
+	os_snprintf(path, sizeof(path), "/sys/class/net/%s/phy80211", ifname);
+	if (access(path, F_OK) == 0)
+		return false;
+	os_snprintf(path, sizeof(path), "/sys/class/net/%s/brport", ifname);
+	return access(path, F_OK) == 0;
+}
+
+
+static int read_rx_packets(struct hostapd_data *hapd, struct sta_info *sta,
+			   unsigned long *rx_packets)
+{
+	struct hostap_sta_driver_data data;
+
+	os_memset(&data, 0, sizeof(data));
+	if (hostapd_drv_read_sta_data(hapd, &data, sta->addr) < 0)
+		return -1;
+	*rx_packets = data.rx_packets;
+	return 0;
+}
+
+
+static void roam_prune_check(void *eloop_ctx, void *timeout_ctx)
+{
+	struct hostapd_data *hapd = eloop_ctx;
+	struct sta_info *sta = timeout_ctx;
+	unsigned long rx_packets;
+
+	if (!(sta->flags & WLAN_STA_ASSOC))
+		return;
+	if (read_rx_packets(hapd, sta, &rx_packets) < 0 ||
+	    rx_packets != sta->roam_prune_rx_packets) {
+		hostapd_logger(hapd, sta->addr, HOSTAPD_MODULE_IEEE80211,
+			       HOSTAPD_LEVEL_INFO,
+			       "Layer 2 Update frame from the distribution system, but the STA is still here; not removed");
+		return;
+	}
+
+	hostapd_logger(hapd, sta->addr, HOSTAPD_MODULE_IEEE80211,
+		       HOSTAPD_LEVEL_INFO,
+		       "associated with another AP of the ESS (Layer 2 Update frame from the distribution system); removed");
+	ap_sta_deauthenticate(hapd, sta, WLAN_REASON_PREV_AUTH_NOT_VALID);
+}
+
+
+static void roam_prune_receive(int sock, void *eloop_ctx, void *sock_ctx)
+{
+	struct hostapd_data *hapd = eloop_ctx;
+	struct sockaddr_ll ll;
+	socklen_t fromlen = sizeof(ll);
+	char ifname[IF_NAMESIZE];
+	u8 buf[20];
+	struct sta_info *sta;
+	ssize_t len;
+
+	len = recvfrom(sock, buf, sizeof(buf), 0, (struct sockaddr *) &ll,
+		       &fromlen);
+	if (len < (ssize_t) sizeof(buf)) {
+		if (len < 0)
+			wpa_printf(MSG_DEBUG, "roam_prune: recvfrom: %s",
+				   strerror(errno));
+		return;
+	}
+	if (!if_indextoname(ll.sll_ifindex, ifname) || !from_ds_port(ifname))
+		return;
+
+	sta = ap_get_sta(hapd, &buf[ETH_ALEN]);
+	if (!sta || !(sta->flags & WLAN_STA_ASSOC) ||
+	    eloop_is_timeout_registered(roam_prune_check, hapd, sta))
+		return;
+	if (read_rx_packets(hapd, sta, &sta->roam_prune_rx_packets) < 0)
+		return;
+
+	wpa_printf(MSG_DEBUG,
+		   "%s: Layer 2 Update frame for STA " MACSTR " on %s",
+		   hapd->conf->iface, MAC2STR(sta->addr), ifname);
+	eloop_register_timeout(ROAM_PRUNE_CHECK_SEC, 0, roam_prune_check,
+			       hapd, sta);
+}
+
+
+int roam_prune_init(struct hostapd_data *hapd)
+{
+	struct sock_fprog prog = {
+		.len = ARRAY_SIZE(l2_update_filter),
+		.filter = l2_update_filter,
+	};
+	int sock, one = 1;
+
+	/* ETH_P_ALL: a socket for one protocol gets a frame received on a
+	 * bridge port only once the bridge passes it up, as received on the
+	 * bridge, and that hides the port. Outgoing frames are not cloned to
+	 * it, and the filter drops all but the Layer 2 Update frame. */
+	sock = socket(PF_PACKET, SOCK_RAW | SOCK_CLOEXEC, htons(ETH_P_ALL));
+	if (sock < 0) {
+		wpa_printf(MSG_ERROR, "roam_prune: socket: %s",
+			   strerror(errno));
+		return -1;
+	}
+	if (setsockopt(sock, SOL_SOCKET, SO_ATTACH_FILTER, &prog,
+		       sizeof(prog)) < 0 ||
+	    setsockopt(sock, SOL_PACKET, PACKET_IGNORE_OUTGOING, &one,
+		       sizeof(one)) < 0) {
+		wpa_printf(MSG_ERROR, "roam_prune: setsockopt: %s",
+			   strerror(errno));
+		close(sock);
+		return -1;
+	}
+	if (eloop_register_read_sock(sock, roam_prune_receive, hapd, NULL)) {
+		close(sock);
+		return -1;
+	}
+	hapd->roam_prune_sock = sock;
+	return 0;
+}
+
+
+void roam_prune_deinit(struct hostapd_data *hapd)
+{
+	if (hapd->roam_prune_sock < 0)
+		return;
+	eloop_unregister_read_sock(hapd->roam_prune_sock);
+	close(hapd->roam_prune_sock);
+	hapd->roam_prune_sock = -1;
+}
+
+
+void roam_prune_sta_free(struct hostapd_data *hapd, struct sta_info *sta)
+{
+	eloop_cancel_timeout(roam_prune_check, hapd, sta);
+}
