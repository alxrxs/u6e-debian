+/*
+ * The group keys a STA gets when it joins (EAPOL-Key msg 3/4, FT, FILS) are
+ * the ones in use. During a group rekey (SETKEYS) the new ones (GN) are not in
+ * use until every STA has them, so a STA joining then gets the previous ones
+ * (GM) and the new ones with the Group Key Handshake once it is in
+ * PTKINITDONE, as does a STA whose keys a rekey replaced before then.
+ */
+static bool wpa_group_rekeying(struct wpa_group *gsm)
+{
+	return gsm->wpa_group_state == WPA_GROUP_SETKEYS;
+}
+
+
+int wpa_auth_join_gtk_idx(struct wpa_state_machine *sm, struct wpa_group *gsm)
+{
+	int idx = wpa_group_rekeying(gsm) ? gsm->GM : gsm->GN;
+
+	sm->gtk_given |= BIT(idx - 1);
+	return idx;
+}
+
+
+int wpa_auth_join_igtk_idx(struct wpa_group *gsm)
+{
+	return wpa_group_rekeying(gsm) ? gsm->GM_igtk : gsm->GN_igtk;
+}
+
+
+int wpa_auth_join_bigtk_idx(struct wpa_state_machine *sm,
+			    struct wpa_group *gsm)
+{
+	int idx = wpa_group_rekeying(gsm) ? gsm->GM_bigtk : gsm->GN_bigtk;
+
+	sm->bigtk_given |= BIT(idx - 6);
+	return idx;
+}
+
+
+/* Start the Group Key Handshake for a STA in PTKINITDONE whose group keys
+ * are older than the current ones; returns whether it was started. */
+static bool wpa_group_update_joined_sta(struct wpa_state_machine *sm)
+{
+	struct wpa_authenticator *bigtk_auth = sm->wpa_auth->conf.tx_bss_auth ?
+		sm->wpa_auth->conf.tx_bss_auth : sm->wpa_auth;
+	bool old = (sm->gtk_given & ~BIT(sm->group->GN - 1)) ||
+		(sm->bigtk_given & ~BIT(bigtk_auth->group->GN_bigtk - 6));
+
+	sm->gtk_given = 0;
+	sm->bigtk_given = 0;
+	if (!old || sm->GUpdateStationKeys || sm->is_wnmsleep)
+		return false;
+
+	wpa_auth_logger(sm->wpa_auth, wpa_auth_get_spa(sm), LOGGER_DEBUG,
+			"joined with group keys a rekey replaces; start Group Key Handshake");
+	sm->group->GKeyDoneStations++;
+	sm->GUpdateStationKeys = true;
+	return true;
+}
+
