index 9998f6c0a..5efbda902 100644
--- a/include/uapi/linux/nl80211.h
+++ b/include/uapi/linux/nl80211.h
@@ -1425,6 +1425,10 @@
  * @NL80211_CMD_STOP_PD: Stop the PD operation, identified by
