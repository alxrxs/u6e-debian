From: John Crispin <john@phrozen.org>
Subject: [PATCH] kernel_build_check

Imported from https://github.com/openwrt/openwrt.git package/kernel/mac80211/patches/build/012-kernel_build_check.patch (added in d9eefa7a70); the patch file carries no author or description.
---
--- a/Makefile
+++ b/Makefile
@@ -2,7 +2,7 @@
 # Makefile for the output source package
 #
 
-ifeq ($(KERNELRELEASE),)
+ifeq ($(KERNELVERSION),)
 
 MAKEFLAGS += --no-print-directory
 SHELL := /usr/bin/env bash
