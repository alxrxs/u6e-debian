From 3f4b3fde179898a28188ac1219cede8278aa3ea5 Mon Sep 17 00:00:00 2001
From: Stanislaw Pal <kuncy7@gmail.com>
Date: Fri, 2 Oct 2026 09:55:28 +0300
Subject: [PATCH] mac80211-ath10k-fix-airtime-underflow

Imported from https://github.com/kuncy7/openwrt-nss-edma package/kernel/mac80211/patches/nss/subsys/970-mac80211-ath10k-fix-airtime-underflow.patch (added in aaacdca9a1); the patch file carries no author or description.
---
 net/mac80211/sta_info.c | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/net/mac80211/sta_info.c b/net/mac80211/sta_info.c
index 3f4487444..520b74ec6 100644
--- a/net/mac80211/sta_info.c
+++ b/net/mac80211/sta_info.c
@@ -2555,10 +2555,7 @@ void ieee80211_sta_update_pending_airtime(struct ieee80211_local *local,
 	atomic_sub(tx_airtime, &local->aql_total_pending_airtime);
 	tx_pending = atomic_sub_return(tx_airtime,
 				       &local->aql_ac_pending_airtime[ac]);
-	if (WARN_ONCE(tx_pending < 0,
-		      "Device %s AC %d pending airtime underflow: %u, %u",
-		      wiphy_name(local->hw.wiphy), ac, tx_pending,
-		      tx_airtime)) {
+	if (tx_pending < 0) {
 		atomic_cmpxchg(&local->aql_ac_pending_airtime[ac],
 			       tx_pending, 0);
 		atomic_sub(tx_pending, &local->aql_total_pending_airtime);
