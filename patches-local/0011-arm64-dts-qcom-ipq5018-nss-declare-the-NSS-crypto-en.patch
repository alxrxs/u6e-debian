From 79bd2dd6f6b791e62821367c80596889f9332474 Mon Sep 17 00:00:00 2001
From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Date: Fri, 2 Oct 2026 10:40:54 +0300
Subject: [PATCH] arm64: dts: qcom: ipq5018-nss: declare the NSS crypto engine

qca-nss-crypto binds to a qcom,nss-crypto node and its CE5 child; without
one the crypto engine the firmware ships has no host driver, and with it
qca-nss-cfi and the IPsec manager. The node is the one the vendor firmware
for this SoC carries: 64 contexts of 144 bytes, CE5 and its BAM, every
cipher/hash/AEAD combination the engine implements, execution environments
2 and 3.
---
 arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi | 45 +++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi b/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi
index f9a799200..7ebdcced0 100644
--- a/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi
+++ b/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi
@@ -91,6 +91,51 @@ nss0: nss@40000000 {
 		qcom,wlan-dataplane-offload-enabled;
 		qcom,rmnet_rx-enabled;
 	};
+
+	/* The CE5 engine, owned by the NSS firmware (the board disables QCE). */
+	nss_crypto: qcom,nss_crypto {
+		compatible = "qcom,nss-crypto";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		qcom,max-contexts = <64>;
+		qcom,max-context-size = <144>;
+		ranges;
+
+		ce5_node {
+			compatible = "qcom,ce5";
+			reg-names = "crypto_pbase",
+				    "bam_base";
+			reg = <0x0073a000 0x6000>,
+			      <0x00704000 0x20000>;
+			qcom,dma-mask = <0x0c>;
+			qcom,transform-enabled;
+			qcom,aes128-cbc;
+			qcom,aes256-cbc;
+			qcom,aes128-ctr;
+			qcom,aes256-ctr;
+			qcom,aes128-ecb;
+			qcom,aes256-ecb;
+			qcom,3des-cbc;
+			qcom,sha160-hash;
+			qcom,sha256-hash;
+			qcom,sha160-hmac;
+			qcom,sha256-hmac;
+			qcom,aes128-cbc-sha160-hmac;
+			qcom,aes256-cbc-sha160-hmac;
+			qcom,aes128-ctr-sha160-hmac;
+			qcom,aes256-ctr-sha160-hmac;
+			qcom,3des-cbc-sha160-hmac;
+			qcom,3des-cbc-sha256-hmac;
+			qcom,aes128-cbc-sha256-hmac;
+			qcom,aes256-cbc-sha256-hmac;
+			qcom,aes128-ctr-sha256-hmac;
+			qcom,aes256-ctr-sha256-hmac;
+
+			engine0 {
+				qcom,ee = <2 3>;
+			};
+		};
+	};
 };
 
 &wifi {
