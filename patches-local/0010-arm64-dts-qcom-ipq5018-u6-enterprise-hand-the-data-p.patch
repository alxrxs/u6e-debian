From 0b2d5a03438ea7122a57c2843aff0af89a705c12 Mon Sep 17 00:00:00 2001
From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Date: Fri, 2 Oct 2026 09:46:37 +0300
Subject: [PATCH] arm64: dts: qcom: ipq5018-u6-enterprise: hand the data plane
 to NSS

Include the NSS core node, give both QCN9074 radios their NSS Wi-Fi offload
priority, and leave the crypto engine to NSS: qca-nss-crypto drives the
same CE5 block through the NSS firmware, so the QCE driver must not bind
it. Kept apart from the board support, which stays upstreamable.
---
 .../dts/qcom/ipq5018-ubnt-u6-enterprise.dts     | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts b/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts
index 4ef7b630f..c1291af82 100644
--- a/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts
+++ b/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts
@@ -4,6 +4,7 @@
 
 #include "ipq5018.dtsi"
 #include "ipq5018-ess.dtsi"
+#include "ipq5018-nss.dtsi"
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
@@ -70,6 +71,18 @@ &blsp1_uart1 {
 	status = "okay";
 };
 
+/*
+ * The crypto engine belongs to NSS (qca-nss-crypto, and through it the
+ * kernel crypto API and IPsec offload), so the QCE driver must not bind it.
+ */
+&crypto {
+	status = "disabled";
+};
+
+&cryptobam {
+	status = "disabled";
+};
+
 &prng {
 	status = "okay";
 };
@@ -245,6 +258,8 @@ wifi@0,0 {
 			reg = <0x00010000 0 0 0 0>;
 			qcom,ath11k-calibration-variant = "Ubiquiti-U6-Enterprise-5G";
 			qcom,ath11k-fw-memory-mode = <1>;
+			/* read only by the NSS Wi-Fi offload */
+			nss-radio-priority = <1>;
 		};
 	};
 };
@@ -266,6 +281,8 @@ wifi@0,0 {
 			reg = <0x00010000 0 0 0 0>;
 			qcom,ath11k-calibration-variant = "Ubiquiti-U6-Enterprise-6G";
 			qcom,ath11k-fw-memory-mode = <1>;
+			/* read only by the NSS Wi-Fi offload */
+			nss-radio-priority = <1>;
 		};
 	};
 };
