From 793714278ea26b869eaf25dcf7b2b007644e0bca Mon Sep 17 00:00:00 2001
From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Date: Fri, 2 Oct 2026 10:41:06 +0300
Subject: [PATCH] arm64: dts: qcom: ipq5018-nss: run the core at the vendor's
 850 MHz

nss-drv boots the UBI32 core at its mid frequency and, with frequency
auto-scaling off, keeps it there. The vendor firmware for this SoC declares
850 MHz for both low and mid and reserves 1 GHz for max, and runs with
auto-scaling off, so its core sits at 850 MHz. Match it.
---
 arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi b/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi
index 7ebdcced0..fed4539e2 100644
--- a/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi
+++ b/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi
@@ -52,7 +52,7 @@ nss0: nss@40000000 {
 		qcom,num-pri = <4>;
 		qcom,load-addr = <0x40000000>;
 		qcom,low-frequency = <850000000>;
-		qcom,mid-frequency = <1000000000>;
+		qcom,mid-frequency = <850000000>;
 		qcom,max-frequency = <1000000000>;
 		qcom,ipv4-enabled;
 		qcom,ipv4-reasm-enabled;
