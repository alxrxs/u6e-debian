From f0b3c7e026417c90e0f6ab23b28aafd8ce0eaa67 Mon Sep 17 00:00:00 2001
From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Date: Fri, 2 Oct 2026 09:45:50 +0300
Subject: [PATCH] arm64: dts: qcom: ipq5018-nss: declare every engine the
 firmware ships

The NSS node lists the features nss-drv registers host handlers for. Use
the vendor firmware's own list for this SoC (crypto, IPsec, CLMAP, PVXLAN,
GRE redirect and mark, port ID, UDP speed test) and add the VLAN and
ingress-shaping handlers its build never loads. A handler for a node the
firmware lacks is never answered and costs nothing; a missing one disables
a working engine: the 12.2 crypto engine passes all kernel crypto
self-tests through qca-nss-cfi.
---
 arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi | 21 +++++++++++++++------
 1 file changed, 15 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi b/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi
index 8d48c2f01..f9a799200 100644
--- a/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi
+++ b/arch/arm64/boot/dts/qcom/ipq5018-nss.dtsi
@@ -2,12 +2,12 @@
 /*
  * NSS (UBI32) node for IPQ5018.
  *
- * The feature list below is trimmed to what the MP firmware blob actually
- * implements, as established by exhaustive dynamic-interface allocation
- * probing on a GL-B3000 running fw 12.2-156 / 12.5-210 (identical blobs):
- * no crypto family (IPSEC/DTLS/TLS/QVPN), no PORTID, no CLMAP, no PVXLAN,
- * no CAPWAP and no GRE_REDIR family.  Advertising them here only makes
- * nss-drv register handlers the firmware will never answer.
+ * The feature list is the one the vendor firmware declares for this SoC,
+ * plus the VLAN and ingress-shaping handlers its own build never loads. A
+ * flag only makes nss-drv register a host-side handler; one the firmware
+ * does not implement goes unanswered and costs nothing, while a missing one
+ * breaks a working engine (the 12.2 crypto engine passes the kernel
+ * self-tests through qca-nss-cfi).
  */
 
 &soc {
@@ -66,6 +66,15 @@ nss0: nss@40000000 {
 		qcom,pptp-enabled;
 		qcom,tunipip6-enabled;
 		qcom,shaping-enabled;
+		qcom,igs-enabled;
+		qcom,clmap-enabled;
+		qcom,crypto-enabled;
+		qcom,ipsec-enabled;
+		qcom,gre-redir-enabled;
+		qcom,gre-redir-mark-enabled;
+		qcom,portid-enabled;
+		qcom,pvxlan-enabled;
+		qcom,udp-st-enabled;
 		/*
 		 * Gates nss_vlan_register_handler(), which is what initialises
 		 * the VLAN message semaphore. Without it the first VLAN message
