From b544ca4afb32a65bfd915fdc0150f6d79159f694 Mon Sep 17 00:00:00 2001
From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Date: Sat, 3 Oct 2026 13:05:22 +0300
Subject: [PATCH 21/23] arm64: dts: qcom: ipq5018-u6-enterprise: add the white
 and blue LEDs

The status light is two GPIO LEDs, white on GPIO2 and blue on GPIO3,
active high, set up as the vendor firmware drives them (2 mA, pull-down).
Blue comes on at boot, the colour the vendor firmware shows when the AP
is up. Mapped on hardware by driving each line on its own.
---
 .../dts/qcom/ipq5018-ubnt-u6-enterprise.dts   | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts b/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts
index 2aba04c92..ff89a33ae 100644
--- a/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts
+++ b/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts
@@ -8,6 +8,7 @@
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
 
 / {
 	model = "Ubiquiti UniFi U6 Enterprise";
@@ -39,6 +40,25 @@ chosen {
 		stdout-path = "serial0:115200n8";
 	};
 
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-0 = <&led_pins>;
+		pinctrl-names = "default";
+
+		led-white {
+			color = <LED_COLOR_ID_WHITE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-blue {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 3 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
+		};
+	};
+
 	keys {
 		compatible = "gpio-keys";
 		pinctrl-0 = <&button_pins>;
@@ -337,6 +357,13 @@ &wifi {
 };
 
 &tlmm {
+	led_pins: led-state {
+		pins = "gpio2", "gpio3";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
 	button_pins: button-state {
 		pins = "gpio24";
 		function = "gpio";
