From 432f8d19c011d14a66e214949bc3dc0b71bfc876 Mon Sep 17 00:00:00 2001
From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Date: Sat, 3 Oct 2026 12:42:08 +0300
Subject: [PATCH 19/23] arm64: dts: qcom: ipq5018-u6-enterprise: enable
 Bluetooth

The IPQ5018's own Bluetooth controller, as the vendor firmware runs it.
The firmware is the vendor's split image (bt_fw_patch.mdt and its .b0x
segments), so name the .mdt rather than the default .mbn.
---
 arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts b/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts
index 11ba1d116..2aba04c92 100644
--- a/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts
+++ b/arch/arm64/boot/dts/qcom/ipq5018-ubnt-u6-enterprise.dts
@@ -398,6 +398,12 @@ i2c_pins: i2c-state {
 	};
 };
 
+/* The firmware ships as the stock split image (bt_fw_patch.mdt + .b0x). */
+&bluetooth {
+	firmware-name = "qca/bt_fw_patch.mdt";
+	status = "okay";
+};
+
 &blsp1_i2c3 {
 	pinctrl-0 = <&i2c_pins>;
 	pinctrl-names = "default";
