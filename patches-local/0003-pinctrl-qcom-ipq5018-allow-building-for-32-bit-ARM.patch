From 680be2ec5b296af7bc2ac4ed4fb12ad6f20effb3 Mon Sep 17 00:00:00 2001
From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Date: Thu, 1 Oct 2026 17:41:13 +0300
Subject: [PATCH] pinctrl: qcom: ipq5018: allow building for 32-bit ARM

The U-Boot shipped on some IPQ5018 boards (e.g. Ubiquiti UniFi U6
Enterprise) runs in AArch32 and only boots 32-bit kernels, and the vendor
firmware on them is armv7. Let the pin controller build for ARM, as
PINCTRL_IPQ4019 already does.
---
 drivers/pinctrl/qcom/Kconfig.msm | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/pinctrl/qcom/Kconfig.msm b/drivers/pinctrl/qcom/Kconfig.msm
index 9409e678e..24c2f7a15 100644
--- a/drivers/pinctrl/qcom/Kconfig.msm
+++ b/drivers/pinctrl/qcom/Kconfig.msm
@@ -60,7 +60,7 @@ config PINCTRL_IPQ4019
 
 config PINCTRL_IPQ5018
 	tristate "Qualcomm IPQ5018 pin controller driver"
-	depends on ARM64 || COMPILE_TEST
+	depends on ARM || ARM64 || COMPILE_TEST
 	default ARCH_QCOM
 	help
 	  This is the pinctrl, pinmux, pinconf and gpiolib driver for
