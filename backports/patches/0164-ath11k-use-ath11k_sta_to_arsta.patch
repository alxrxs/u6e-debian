From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stanislaw Pal <kuncy7@gmail.com>
Date: Fri, 2 Oct 2026 10:17:27 +0300
Subject: [PATCH 164/192] ath11k-use-ath11k_sta_to_arsta

Imported from https://github.com/kuncy7/openwrt-nss-edma package/kernel/mac80211/patches/nss/ath11k/999-903-ath11k-use-ath11k_sta_to_arsta.patch (added in aaacdca9a1); the patch file carries no author or description.
---
 drivers/net/wireless/ath/ath11k/debugfs_sta.c |  2 +-
 drivers/net/wireless/ath/ath11k/dp_rx.c       | 11 +++++------
 drivers/net/wireless/ath/ath11k/mac.c         |  2 +-
 3 files changed, 7 insertions(+), 8 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/debugfs_sta.c b/drivers/net/wireless/ath/ath11k/debugfs_sta.c
index b673885..077246d 100644
--- a/drivers/net/wireless/ath/ath11k/debugfs_sta.c
+++ b/drivers/net/wireless/ath/ath11k/debugfs_sta.c
@@ -1208,7 +1208,7 @@ static ssize_t ath11k_dbg_sta_reset_rx_stats(struct file *file,
 					     size_t count, loff_t *ppos)
 {
 	struct ieee80211_sta *sta = file->private_data;
-	struct ath11k_sta *arsta = (struct ath11k_sta *)sta->drv_priv;
+	struct ath11k_sta *arsta = ath11k_sta_to_arsta(sta);
 	struct ath11k *ar = arsta->arvif->ar;
 	int ret, reset;
 
diff --git a/drivers/net/wireless/ath/ath11k/dp_rx.c b/drivers/net/wireless/ath/ath11k/dp_rx.c
index aa384a1..1a66ca9 100644
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -1576,7 +1576,7 @@ static void ath11k_dp_ppdu_stats_flush_tlv_parse(struct ath11k_base *ab, struct
 		goto exit;
 
 	sta = peer->sta;
-	arsta = (struct ath11k_sta *)sta->drv_priv;
+	arsta = ath11k_sta_to_arsta(sta);
 
 	memset(&status, 0, sizeof(status));
 
@@ -1942,7 +1942,7 @@ ath11k_dp_rx_ppdu_stats_update_tx_comp_status(struct ath11k *ar,
 		}
 
 		sta = peer->sta;
-		arsta = (struct ath11k_sta *)sta->drv_priv;
+		arsta = ath11k_sta_to_arsta(sta);
 
 		memset(&status, 0, sizeof(status));
 
@@ -3000,8 +3000,7 @@ static void ath11k_dp_rx_h_mpdu(struct ath11k *ar,
 				msdu->protocol = eth_type_trans(msdu, msdu->dev);
 				napi_gro_receive(rxcb->napi, msdu);
 				if (peer->sta)
-					arsta =
-					(struct ath11k_sta *)peer->sta->drv_priv;
+					arsta = ath11k_sta_to_arsta(peer->sta);
 				return;
 			}
 		}
@@ -3772,7 +3771,7 @@ static void ath11k_dp_rx_update_user_stats(struct ath11k *ar,
 		return;
 	}
 
-	arsta = (struct ath11k_sta *)peer->sta->drv_priv;
+	arsta = ath11k_sta_to_arsta(peer->sta);
 	rx_stats = arsta->rx_stats;
 
 	if (ar->ab->nss.enabled)
@@ -6475,7 +6474,7 @@ int ath11k_dp_rx_process_mon_status(struct ath11k_base *ab, int mac_id,
 		if ((ppdu_info->fc_valid) &&
 		    (ppdu_info->ast_index != HAL_AST_IDX_INVALID)) {
 			if (ppdu_info->reception_type == HAL_RX_RECEPTION_TYPE_SU) {
-				arsta = (struct ath11k_sta *)peer->sta->drv_priv;
+				arsta = ath11k_sta_to_arsta(peer->sta);
 				ath11k_dp_rx_update_peer_su_stats(arsta, ppdu_info);
 				ath11k_nss_update_sta_rxrate(ppdu_info, peer, NULL);
 			} else {
diff --git a/drivers/net/wireless/ath/ath11k/mac.c b/drivers/net/wireless/ath/ath11k/mac.c
index 3b06b31..3c55ff7 100644
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -4641,7 +4641,7 @@ static int ath11k_mac_op_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 	mutex_lock(&ar->conf_mutex);
 	if (sta) {
 		peer_addr = sta->addr;
-		arsta = (struct ath11k_sta *)sta->drv_priv;
+		arsta = ath11k_sta_to_arsta(sta);
 	} else if (arvif->vdev_type == WMI_VDEV_TYPE_STA) {
 		peer_addr = vif->bss_conf.bssid;
 	} else {
