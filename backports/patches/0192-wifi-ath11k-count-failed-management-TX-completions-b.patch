From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Date: Sat, 17 Oct 2026 01:10:25 +0300
Subject: [PATCH] wifi: ath11k: count failed management TX completions by
 status

dump_mgmt_stats counts the failure completions of management frames per
frame type, but not why they failed. Count them by the firmware's
completion status as well, so a lost ACK (status 3 on WLAN.HK firmware)
can be told from a discarded frame.

Assisted-by: LLM
Signed-off-by: Andrei-Alexandru Bleortu <me@andrei-z.com>
---
 drivers/net/wireless/ath/ath11k/core.h    | 2 ++
 drivers/net/wireless/ath/ath11k/debugfs.c | 5 +++++
 drivers/net/wireless/ath/ath11k/wmi.c     | 7 +++++--
 3 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/core.h b/drivers/net/wireless/ath/ath11k/core.h
index 55fc98c..018482e 100644
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -383,6 +383,8 @@ struct ath11k_mgmt_frame_stats {
 	u32 rx_cnt[ATH11K_STATS_MGMT_FRM_TYPE_MAX];
 	u32 tx_compl_succ[ATH11K_STATS_MGMT_FRM_TYPE_MAX];
 	u32 tx_compl_fail[ATH11K_STATS_MGMT_FRM_TYPE_MAX];
+	/* failure completions by firmware status (the last counts any above) */
+	u32 tx_compl_status[8];
 };
 
 /**
diff --git a/drivers/net/wireless/ath/ath11k/debugfs.c b/drivers/net/wireless/ath/ath11k/debugfs.c
index 5c3a605..43ffca4 100644
--- a/drivers/net/wireless/ath/ath11k/debugfs.c
+++ b/drivers/net/wireless/ath/ath11k/debugfs.c
@@ -1663,6 +1663,11 @@ static ssize_t ath11k_dump_mgmt_stats(struct file *file, char __user *ubuf,
 		for (i = 0; i < ATH11K_STATS_MGMT_FRM_TYPE_MAX-1; i++)
 			len += scnprintf(buf + len, size - len, "       %s: %d\n", mgmt_frm_type[i],
 					 mgmt_stats->tx_compl_fail[i]);
+		len += scnprintf(buf + len, size - len, " failure completions by status:");
+		for (i = 1; i < ARRAY_SIZE(mgmt_stats->tx_compl_status); i++)
+			len += scnprintf(buf + len, size - len, " %d=%u", i,
+					 mgmt_stats->tx_compl_status[i]);
+		len += scnprintf(buf + len, size - len, "\n");
 	}
 
 	spin_unlock_bh(&ar->data_lock);
diff --git a/drivers/net/wireless/ath/ath11k/wmi.c b/drivers/net/wireless/ath/ath11k/wmi.c
index 9625161..ef97013 100644
--- a/drivers/net/wireless/ath/ath11k/wmi.c
+++ b/drivers/net/wireless/ath/ath11k/wmi.c
@@ -6280,10 +6280,13 @@ static int wmi_process_tx_comp(struct ath11k *ar,
 		arvif = ath11k_vif_to_arvif(vif);
 		mgmt_stats = &arvif->mgmt_stats;
 
-		if (!tx_compl_param->status)
+		if (!tx_compl_param->status) {
 			mgmt_stats->tx_compl_succ[frm_type]++;
-		else
+		} else {
 			mgmt_stats->tx_compl_fail[frm_type]++;
+			mgmt_stats->tx_compl_status[min_t(u32, tx_compl_param->status,
+				ARRAY_SIZE(mgmt_stats->tx_compl_status) - 1)]++;
+		}
 	}
 
 skip_mgmt_stats:
