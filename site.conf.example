# shellcheck shell=bash disable=SC2034
# Site configuration for the U6-Enterprise image and its boot tooling: copy to
# site.conf (not tracked) and fill in. prep-rootfs.sh and boot/*.sh source it.

# Management: a tagged VLAN on the uplink with a static address - how the
# stock firmware runs with a UniFi controller's static network settings.
MGMT_VLAN=11
MGMT_GW=192.0.2.1
MGMT_DNS=192.0.2.53
MGMT_DOMAIN=example.net
# NTP server(s); the AP has no real-time clock.
MGMT_NTP=192.0.2.123
# Syslog collector (address:port) the AP sends its journal to.
LOG_SERVER=192.0.2.10:514
# Wi-Fi clients: a VLAN bridged, unaddressed, into br<vid>; hostapd adds the
# radios to it.
CLIENT_VLAN=42
# Every VLAN a client can land in (RADIUS assigns some), CLIENT_VLAN the
# default; each is bridged the same way.
WIFI_VLANS="42 43"
# root's authorized_keys in the image.
ROOT_AUTHORIZED_KEYS=/root/.ssh/id_ed25519.pub
# Optional: the known_hosts file the boot tooling checks each AP's host keys
# against, two entries per AP since both of its systems answer on its address:
# "<AP_HOSTNAME> <key>" for our image (its ssh_host_key's public half) and
# "<AP_HOSTNAME>-stock <key>" for each of the stock firmware's keys. Unset, no
# host key is checked.
AP_KNOWN_HOSTS=~/.config/u6e/known_hosts
# Proprietary inputs (Wi-Fi firmware, the stock board data): see README.md.
BLOBS=../u6e-blobs
# Optional: "<ssh login> <OrbStack machine>" on an Apple silicon Mac, where
# deploy.sh runs the arm64 builds (packages, rootfs) natively whenever the Mac
# answers; empty or unreachable, they run here under qemu-user.
NATIVE_BUILD="user@mac.example u6e-build"
# 1: once the management network is up, the image re-arms its own boot, so it
# survives reboots and power cuts (README.md, Persistent mode). 0: every boot
# armed by boot/go8.sh is one-shot.
U6E_PERSIST=0
# 1: bluetoothd powers the Bluetooth controller at boot. 0: it stays off until
# powered by hand (bluetoothctl power on).
BT_POWERED=1
# Experimental, off unless set (README.md, Experimental). NSS_SHAPERS: MB of
# host RAM the NSS firmware takes for its shapers at boot, for good; unset,
# none. U6E_PCC=1: load u6e-pcc and create its mirror device mirror.0;
# registering it keeps every DNS connection on the CPU, and it stays loaded
# until the next boot.
#NSS_SHAPERS=4
#U6E_PCC=1
# Optional: the Wi-Fi controller u6e-agent streams the AP's Wi-Fi state to
# (host:port), and the controller's Ed25519 public key (64 hex digits), which
# the agent pins: a plain value, not a secret. Each AP's own private key is
# agent_key in its block below. CONTROLLER unset: no controller link.
CONTROLLER=controller.example.net:8443
CONTROLLER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional, with CONTROLLER: the deploy runner's Ed25519 public key (64 hex
# digits, a plain value). The AP applies the live Wi-Fi configurations the
# runner signs with it, and nothing else; unset, it applies none.
RUNNER_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
# Optional, with RUNNER_KEY: how deploy.sh tells the runner, as root, the
# kept image it staged on an AP, the one a failed rollout goes back to; and
# whether the runner keeps a rollout under way, when deploy.sh refuses to
# start (the runner's state directory holds it as `rollout`).
runner_staged() { u6e-deploy staged "$1" "$2"; }
runner_rolling_out() { [ -e /var/lib/u6e-deploy/rollout ]; }
# ...and the kept images it needs, which deploy.sh never prunes.
runner_images() { u6e-deploy images; }
# Optional: the newest kept images of each AP deploy.sh keeps however old
# (default 3), and the room in GiB a run needs on the tree's filesystem
# (default 15).
#KEEP_IMAGES=3
#MIN_FREE_GIB=15

# Stock firmware SSH: the controller's "Device Authentication" user, and a
# command printing its password.
STOCK_USER=ubnt
stock_password() { cat ~/.config/u6e/stock-password; }


# boot/wifi-up.sh: the SSIDs, the regulatory country and each radio's channel
# (hostapd lines). The example is stock's plan in South Korea (KR); check what
# your country allows.
WIFI_COUNTRY=KR
# One SSID per line: name|kind|bands|VLAN. kind: sae (WPA3-Personal), ent
# (WPA3-Enterprise over RadSec) or psk-mab (WPA2-Personal plus RADIUS MAC
# authentication); bands: any of 24 5 6 (6 GHz: WPA3 only); VLAN: the default
# one, RADIUS may assign another of WIFI_VLANS.
WIFI_SSIDS=(
	"example-enterprise|ent|5 6|42"
	"example-iot|psk-mab|24 5|42"
	"example|sae|24 5 6|42"
)
wifi_psk() { cat ~/.config/u6e/"$1".psk; } # <SSID>
# 802.11r key the radios hand roaming keys over with (64 hex digits).
wifi_ft_key() { cat ~/.config/u6e/wifi-ft-key; }
# RADIUS over TLS (RadSec, RFC 6614) for the ent and psk-mab SSIDs: the
# server's name, its CA and this AP's client certificate and (encrypted) key.
WIFI_RADSEC_SERVER=radius.example.org
radsec_ca() { cat ~/.config/u6e/radsec-ca.pem; }
radsec_cert() { cat ~/.config/u6e/radsec-client.pem; }
radsec_key() { cat ~/.config/u6e/radsec-client.key; }
radsec_key_pass() { cat ~/.config/u6e/radsec-client-key-pass; }
# test/: a client with a Wi-Fi card (SSH target, its host key in your
# known_hosts; its network namespace and interface, its wpa_supplicant, 2.11 or
# newer), a RADIUS account to join the ent SSIDs with (identity and password,
# one per line) and the EAP server's CA.
TEST_CLIENT=user@192.0.2.50 TEST_NETNS=wifi TEST_IFACE=wlan0
TEST_SUPPLICANT=/usr/sbin/wpa_supplicant
wifi_test_eap() { cat ~/.config/u6e/test-eap; }
wifi_eap_ca() { cat ~/.config/u6e/eap-ca.pem; }
WIFI_24="hw_mode=g
channel=13"
# Transmit power per radio (2.4, 5, 6 GHz) in dBm.
WIFI_TXPOWER="22 26 26"
# 6 GHz BSSs as one Multiple BSSID set (one beacon for all; every 6 GHz
# client parses it): 1 or 0.
WIFI_6_MBSSID=1

# Per AP: U6E_AP (default ap1) picks one for every script; U6E_APS lists them
# all (wifi-up.sh gives each AP's neighbor reports the others' BSSs). AP_LED:
# the status LED, off, blue or white. WIFI_COLORS: each radio's HE BSS colour
# (2.4, 5, 6 GHz), different from any AP in range on the same channel.
U6E_APS="ap1"
case ${U6E_AP:-ap1} in
ap1)
	AP_HOSTNAME=u6e-ap1
	MGMT_ADDR=192.0.2.16/24
	AP_LED=off
	WIFI_COLORS="11 22 33"
	# With CONTROLLER: a command printing this AP's Ed25519 private key
	# (PKCS#8 PEM) for the controller link.
	agent_key() { cat ~/.config/u6e/agent-ap1.pem; }
	# Optional: a command printing this AP's SSH host key, an unencrypted
	# Ed25519 key in OpenSSH's format (ssh-keygen -t ed25519 -N ''), the
	# image's only one. Unset, the image makes new keys at every boot.
	ssh_host_key() { cat ~/.config/u6e/ssh-host-ap1; }
	# boot/powercycle.sh: cut and restore the AP's power, e.g. its PoE
	# injector's smart plug.
	power_off() { echo "power_off: not configured" >&2; return 1; }
	power_on() { echo "power_on: not configured" >&2; return 1; }
	# no_pri_sec_switch: keep primary 149; hostapd's 20/40 coexistence scan would
	# otherwise swap it with the secondary when something beacons there.
	# 802.11-2024 11.15.3.2 makes avoiding that a "should", but a "shall" to
	# follow an existing 20/40 MHz BSS's primary: drop it if one shares the block.
	WIFI_5="hw_mode=a
channel=149
no_pri_sec_switch=1
ht_capab=[HT40+]
ieee80211ac=1
vht_oper_chwidth=1
vht_oper_centr_freq_seg0_idx=155
he_oper_chwidth=1
he_oper_centr_freq_seg0_idx=155"
	# 6 GHz: a 160 MHz block with a PSC primary, inside the band the clients'
	# region allows (EU: 5945-6425 MHz, channels 1-93), and a whole block clear of
	# any other 6 GHz AP in range: next to another 160 MHz BSS, clients' frames are lost.
	# Indoor (LPI) AP; Transmit Power Envelope client PSD in 0.5 dB units: KR LPI
	# allows 2 dBm/MHz (24 dBm EIRP) for APs and clients alike.
	WIFI_6="hw_mode=a
op_class=134
channel=53
he_oper_chwidth=2
he_oper_centr_freq_seg0_idx=47
he_6ghz_reg_pwr_type=0
reg_def_cli_eirp_psd=4
reg_sub_cli_eirp_psd=4"
	;;
*) echo "site.conf: unknown U6E_AP '$U6E_AP'" >&2; return 1 ;;
esac
